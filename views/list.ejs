  //       { method: 'DELETE' }
  //     );

  //     if (!response.ok) {
  //       throw new Error('删除请求失败');
  //     }

  //     button.closest('.panel').remove();
  //   } catch (error) {
  //     alert('删除失败，请重试');
  //   }
  // }
</script>
  </body>
</html>
